ZOHO_DC=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_TECH_DEPARTMENT_ID=
ZOHO_SOURCE_FIELD=cf_source

# Spam protection (Cloudflare Turnstile). Required in production.
# For local testing, Cloudflare's always-pass test keys work:
#   site key   1x00000000000000000000AA
#   secret key 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Rate-limit store (Upstash Redis). Required on serverless hosts (Vercel,
# Netlify…); optional on a single long-running server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Max tickets per day across the whole form (protects the shared Zoho quota).
TICKETS_DAILY_LIMIT=200

# Optional
RESEND_API_KEY=
